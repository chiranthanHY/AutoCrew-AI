# ============================================================
# AutoCrew AI — Environment Configuration
# Neon Serverless PostgreSQL + Groq + Tavily Edition
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------
# Application
# ------------------------------------
PROJECT_NAME="AutoCrew AI"
ENVIRONMENT=development

# Max Critic→Executor revision loops before forcing Verifier
MAX_ITERATIONS=5

# Critic score threshold to pass (0–10). Drafts scoring below this get revised.
CRITIC_APPROVAL_THRESHOLD=8.0

# ------------------------------------
# LLM — Groq (Required)
# ------------------------------------
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Primary model (70B for best quality)
GROQ_MODEL_NAME=llama-3.1-70b-versatile

# Fast model for lightweight tasks (query generation, routing)
GROQ_FAST_MODEL_NAME=llama3-8b-8192

# LLM temperature (0.0 = deterministic, 1.0 = creative)
GROQ_TEMPERATURE=0.2

# ------------------------------------
# Tools — Tavily Search (Optional)
# ------------------------------------
# Get your key at: https://tavily.com
# Leave blank to disable web research (Executor will work without it)
TAVILY_API_KEY=tvly_your_tavily_api_key_here

# ------------------------------------
# Database — Neon Serverless PostgreSQL
# ------------------------------------
# ── Option A: Neon (Recommended for production) ──────────────────────────
# 1. Create a free project at: https://neon.tech
# 2. Go to your project → Connection Details
# 3. Copy the "Pooled connection" string (recommended for app traffic)
#    Format: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname
# 4. Use the "Direct connection" ONLY for running migrations/setup scripts
#
# IMPORTANT: Neon requires SSL. The app adds ?sslmode=require automatically.
#
DATABASE_URL=postgresql://your_user:your_password@ep-cool-lab-a1b2c3d4-pooler.us-east-2.aws.neon.tech/autocrew?sslmode=require
DATABASE_SSL_MODE=require

# ── Option B: Local PostgreSQL (for local dev without Neon) ──────────────
# Uncomment this and comment out the Neon DATABASE_URL above
# DATABASE_URL=postgresql://autocrew:autocrew@localhost:5432/autocrew
# DATABASE_SSL_MODE=disable

# Connection pool settings (for the app-level SQLAlchemy pool)
# With Neon's PgBouncer, NullPool is used (these only apply to local Postgres)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# ------------------------------------
# Observability — LangSmith (Optional)
# ------------------------------------
# Get your key at: https://smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__your_langsmith_api_key_here
# LANGCHAIN_PROJECT=autocrew_ai

# ------------------------------------
# Production Only
# ------------------------------------
# Restrict CORS to your actual frontend URL in production
# FRONTEND_URL=https://your-app.vercel.app
