# ==========================================================
#  AutoCrew AI — Environment Variables Reference
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ==========================================================

# ----------------------------------------------------------
# LLM — Groq (primary)
# Get your key at https://console.groq.com/keys
# ----------------------------------------------------------
GROQ_API_KEY="your-groq-api-key-here"

# Groq model to use for main agents (planner, executor, verifier, critic)
# Options: llama-3.3-70b-versatile | llama-3.1-70b-versatile | llama3-70b-8192
GROQ_MODEL_NAME="llama-3.3-70b-versatile"

# Groq model for the fast/cheap Researcher query generation step
GROQ_FAST_MODEL_NAME="llama-3.1-8b-instant"

# ----------------------------------------------------------
# Tools — Tavily Web Search
# Get your key at https://tavily.com
# ----------------------------------------------------------
TAVILY_API_KEY="your-tavily-api-key-here"

# ----------------------------------------------------------
# Database — PostgreSQL (LangGraph checkpoint persistence)
# Format: postgresql://user:password@host:port/dbname
# For Neon: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# ----------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/autocrew"

# ----------------------------------------------------------
# Observability — LangSmith (optional but recommended)
# Get your key at https://smith.langchain.com
# ----------------------------------------------------------
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY="your-langsmith-api-key-here"
LANGCHAIN_PROJECT="autocrew_ai"

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
# "development" | "production"
ENVIRONMENT="development"

# Max critique-revision loops before forcing Verifier (safety valve)
MAX_ITERATIONS=5

# Critique score threshold: drafts scoring BELOW this are sent back to Executor
CRITIC_APPROVAL_THRESHOLD=8.0
